# School ERP monorepo: frontend/ (React + Vite) and backend/ (NestJS + MongoDB).
# Patterns without a leading slash apply in every folder, so they cover both workspaces.

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Environment variables: secrets stay local. Commit the .env.example files instead.
.env
.env.*
!.env.example
*.local

# Tests and coverage
coverage/
.nyc_output/
test-results/
playwright-report/

# Caches
.cache/
.eslintcache
.stylelintcache
.vite/
vite.config.*.timestamp-*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploaded files saved by the backend while developing
uploads/

# Editors: keep shared VS Code settings, ignore personal ones
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code: skills and project settings are shared; personal settings are not
.claude/settings.local.json

# Operating system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
