# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api

# CORS Configuration (comma-separated list of allowed origins or '*' for wildcard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_CREDENTIALS=true

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/skooly_erp
MONGODB_DB_NAME=skooly_erp

# Swagger Documentation Configuration
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Authentication: permission checks run only when true. Keep false until the login module exists,
# otherwise every protected endpoint returns 401. MUST be true in production.
AUTH_ENABLED=false

# Uploaded files (branding images, documents). Served at <PUBLIC_BASE_URL>/uploads/...
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000

# Where the web app runs. Invitation and password-reset links in emails point here.
APP_URL=http://localhost:5173

# Sign-in sessions. The cookie is httpOnly; its value is a random token, stored only as a hash.
SESSION_COOKIE_NAME=skooly_session
SESSION_COOKIE_DOMAIN=
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_DAYS=30
SESSION_REMEMBER_ME_DAYS=30

# Sign-in safety: wrong passwords in a row before the account locks, and for how long.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# How long emailed links stay usable.
INVITATION_EXPIRY_HOURS=72
PASSWORD_RESET_EXPIRY_MINUTES=60

# Email (invitations, password resets). Leave SMTP_HOST empty to log emails instead of sending them.
# Gmail needs an app password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Skooly <no-reply@example.com>
