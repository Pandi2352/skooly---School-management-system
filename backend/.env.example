# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api

# CORS Configuration (comma-separated list of allowed origins or '*' for wildcard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_CREDENTIALS=true

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/skooly_erp
MONGODB_DB_NAME=skooly_erp

# Swagger Documentation Configuration
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Authentication. When false, endpoints answer without a sign-in and no permission is checked:
# useful on a laptop before the first account exists. The server REFUSES TO START in production
# with this false, and warns about it on every start elsewhere.
AUTH_ENABLED=false

# Set when a proxy or load balancer sits in front of this API, so the real client address is read
# from X-Forwarded-For: "true" (one hop), a hop count, or a subnet. Leave empty when there is none —
# trusting a header nobody set lets anyone spoof the address the rate limiter counts.
TRUST_PROXY=

# Uploaded files (branding images, documents). Served at <PUBLIC_BASE_URL>/uploads/...
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000

# Where the web app runs. Invitation and password-reset links in emails point here.
APP_URL=http://localhost:5173

# Sign-in sessions. The cookie is httpOnly; its value is a random token, stored only as a hash.
SESSION_COOKIE_NAME=skooly_session
SESSION_COOKIE_DOMAIN=
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_DAYS=30
SESSION_REMEMBER_ME_DAYS=30

# Sign-in safety: wrong passwords in a row before the account locks, and for how long.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Two-step sign-in. TWO_FACTOR_KEY encrypts the seeds an authenticator app is set up with; without
# it, two-step sign-in stays switched off. Any long random text will do, and CHANGING IT LOCKS
# EVERYONE OUT of their authenticator app, so keep it with your other secrets.
TWO_FACTOR_KEY=
TWO_FACTOR_CHALLENGE_MINUTES=5

# How long emailed links stay usable.
INVITATION_EXPIRY_HOURS=72
PASSWORD_RESET_EXPIRY_MINUTES=60

# Email (invitations, password resets). Leave SMTP_HOST empty to log emails instead of sending them.
# Gmail needs an app password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Skooly <no-reply@example.com>
