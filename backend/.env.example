# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api

# CORS Configuration (comma-separated list of allowed origins or '*' for wildcard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_CREDENTIALS=true

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/skooly_erp
MONGODB_DB_NAME=skooly_erp

# Swagger Documentation Configuration
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Authentication: permission checks run only when true. Keep false until the login module exists,
# otherwise every protected endpoint returns 401. MUST be true in production.
AUTH_ENABLED=false

# Uploaded files (branding images, documents). Served at <PUBLIC_BASE_URL>/uploads/...
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000
